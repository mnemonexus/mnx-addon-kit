{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "@mnemonexus/addon-sdk": [
        "./sdk/src/index.d.ts"
      ],
      "@mnemonexus/addon-sdk/pack": [
        "./sdk/src/build-pack.d.ts"
      ],
      "@mnemonexus/addon-sdk/*": [
        "./sdk/src/*.d.ts"
      ],
      "@mnemonexus/addon-ui": [
        "./ui/src/index.d.ts"
      ]
    },
    "resolveJsonModule": true
  }
}
